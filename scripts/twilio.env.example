# Copy to twilio.env (gitignored) and fill in.
# Twilio Console → Account SID / Auth Token
# Messaging → Try WhatsApp → Sandbox

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox sender (from Twilio WhatsApp sandbox page):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional overrides
# POLL_MS=10000
# COOLDOWN_MS=1800000
# FIREBASE_DB_URL=https://asai-taj-delhi-default-rtdb.asia-southeast1.firebasedatabase.app
